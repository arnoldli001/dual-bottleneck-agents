# 敏感文件
.env
*.key
*_secret.*

# 缓存
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
*.db
# SQLite 在 WAL 模式下打开库时会生成这两个伴生文件（-shm 索引 / -wal 预写日志）。
# 它们由"读取"动作就会产生，属于运行时残留，不应入库。
*.db-shm
*.db-wal
llm_cache.db

# 运行时工作区
#
# `argus-workspace/` 同时承担两个角色：
#   1. 重跑实验时的输出目录（运行时产物，不应入库）
#   2. 论文所用实验数据的存放位置（需要随仓库发布，保证可复现）
#
# 因此这里排除的是「目录内容」而不是「目录本身」——
# `argus-workspace/` 结尾不加 `/`，才能用 `!` 逐个放行下面的数据子目录。
# （Git 规则：父目录被整体排除后，其内部文件无法再被重新包含。）
argus-workspace/*
argus-workspace/_runtime/

# 例外：论文数据（随仓库发布，见 README「数据说明」）
!argus-workspace/full/
!argus-workspace/improved_real/
!argus-workspace/improved_real_run1_hexbug/
!argus-workspace/smoke_real/
# 第二代词法缺陷修复前的中间态日志（240 轮）。放行的理由：
# paper/main.tex 附录 E 与 reports/improvement_validation_real.md §6.4
# 都明确报告了这一中间态的数值（L1/L2/L3 = 98.8% / 71.2% / 58.8%）
# 并称其为"下界而非结果"。若不放行，读者无法核实这一说法，
# 只能选择相信或不相信——这与本仓库"日志可离线复现"的前提相矛盾。
!argus-workspace/improved_real_v1_lexbug/

# 课程控制器状态文件（运行时生成）
# 用 `/state/` 而非 `state/`：后者会匹配任意深度的 state/ 目录，
# 误伤 argus-workspace/full/state/（该目录是实验状态记录，需要发布）。
/state/

# 旧 git 历史备份（CLEAN-1 时保留，不入库）
.git.backup/

# 虚拟环境
.venv/
venv/
env/

# 大文件
*.zip
*.tar.gz

# IDE
.vscode/
.idea/
*.swp

# 系统
.DS_Store
Thumbs.db

# 运行日志
*.log
*.err

# 中文图生成的中转产物
# paper/_zh_figs.py 先把无边框原图写到 reports/_zh_raw/，再用 normalize()
# 加边框输出到 paper/figures_zh/（那才是交付物）。中转目录 2.4 MB 且随时可
# 重生成，不入库。_zh_strings.json / _zh_hash*.txt 是同一流程的清单与校验快照。
reports/_zh_raw/
reports/_zh_scratch/
reports/_zh_strings.json
reports/_zh_hash*.txt
reports/_zhb.txt

# 归档（如不上传，去掉注释）
# archive/

# 开发内部资料（保留在本地，不随仓库发布）
# 需求/设计文档属于开发过程产物，论文写作仍需参考，因此只从索引移除、不删文件。
需求文档/
文档/

# 论文写作笔记（规格文档、架构设计依据、数学猜想验证等）
# 从 文档/ 拆分而来：论文写作需要，但不作为开源内容发布。
paper_notes/

# LaTeX 论文源码（paper/main.tex、refs.bib、checklist.tex、figures/）
# 源码与仓库绑定会暴露作者身份，是否入库由作者自行决定（当前选择：入库）。
# 用 `paper/*` 而非 `paper/`：父目录被整体排除后，内部文件无法再被 `!` 重新包含。
# main.tex 的 \author 自 2026-10-13 起为真实署名与联系邮箱（作者确认保留）。
# refs.bib 自 2026-10-13 起入库：已逐条核实 10 条文献全部为第三方工作、
#   不含任何自引，双盲理由不成立；且 main.tex 里写着 \bibliography{refs}，
#   只提交 main.tex 会让克隆者拿到一个无法编译的论文。
# figures/ 自 2026-10-13 起入库：main.tex 引用 figures/*.png，但仓库里原本
#   一张图都没有，克隆者无法编译。注意必须先放行目录本身，否则其中的文件
#   无法再被 `!` 重新包含。
# checklist.tex 仍排除。
#
# 中文版图 figures_zh/ 自 2026-10-13 起入库：这是 figures/ 那 12 张的中文注记版，
#   尺寸与长宽比一一对应（差异 <2%），换过去不影响图片位置与版式。
#   生成脚本 _zh_figs.py + _zh_fig_terms.py 一并入库，克隆者才能重出这套图：
#   它们不修改那 8 个英文生成脚本，而是拦下 matplotlib 的文字 API、按术语表
#   把图内文字换成中文，再统一加边框输出。
# 中文版正文自 2026-10-16 起入库（作者决定：全部入库，连产物一起）。
#   在此之前 main_zh.tex / _zh_part*.tex 全部被忽略，后果是中文的每次修改
#   都无法 diff、无法 review、无法回滚，提交里也看不到——曾因此误以为中文漏改。
#   入库范围 = 构建必需集：
#     main_zh.tex        拼装产物（作者选择连产物一起提交，clone 者不跑脚本即可编译）
#     _zh_part1..4.tex   中文正文的真实源码（实际文字都在这里）
#     _zh_assemble.py    拼装脚本（含 3 条中文规范检查与结构等价检查）
#     _zh_pagecount.py   页数测量工具（正文是否落在 9 页内）
#   paper/ 下另有约 20 个 _zh_*.py 一次性诊断脚本（_zh_mathdiff / _zh_spotcheck /
#   _del_zh_appE 等），属于用过即弃的工具，不入库。
#   注意：main_zh.tex 与 _zh_part1.tex 的 \author 含真实邮箱，与 main.tex 一致
#   （作者已确认保留），因此入库不新增信息暴露。
paper/*
!paper/main.tex
!paper/refs.bib
!paper/figures/
!paper/figures/*.png
!paper/figures_zh/
!paper/figures_zh/*.png
!paper/figures_zh/README.md
!paper/_zh_figs.py
!paper/_zh_fig_terms.py
!paper/main_zh.tex
!paper/_zh_part1.tex
!paper/_zh_part2.tex
!paper/_zh_part3.tex
!paper/_zh_part4.tex
!paper/_zh_assemble.py
!paper/_zh_pagecount.py

# 条件 C Δ_t 修正前的原始日志备份
# scripts/rederive_condition_c_delta_t.py --apply 会把改动过的 round_*.jsonl
# 逐字节备份到 <logs_root>_pre_c_fix/ 再就地改写 delta_t 字面量。
# 改动清单（含每个旧值）已入库：reports/condition_c_delta_t_correction.json；
# 原始值同时存在于 git 历史中，因此备份目录不入库。
argus-workspace/full/logs_pre_c_fix/

# 归档脚本（目录尚不存在，预留规则）
archive/deprecated_scripts/

# 编辑器/工具产生的临时与备份文件
*.bak
*.tmp
